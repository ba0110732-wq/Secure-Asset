{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm --filter @workspace/api-spec run codegen && PORT=3000 BASE_PATH=/ pnpm --filter @workspace/engineer-portal build",
  "outputDirectory": "artifacts/engineer-portal/dist/public",
  "installCommand": "npm install -g pnpm@10 && pnpm install --no-frozen-lockfile",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/api", "destination": "/api/index" },
    {
      "source": "/((?!api/|api$|assets/|images/|favicon\\.svg|robots\\.txt|sitemap\\.xml|manifest\\.webmanifest|sw\\.js|icon-.*\\.png|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/blog",
      "schedule": "0 6 * * *"
    }
  ]
}
